# Supabase — copia estos valores desde tu proyecto:
# Supabase Dashboard → Project Settings → Data API / API Keys
#
# Para desarrollo local: copia este archivo a `.env.local` y rellena los valores.
# En Vercel: añádelos en Project Settings → Environment Variables.
#
# Si estas variables NO están definidas, la app funciona igualmente
# guardando los datos en el navegador (localStorage), sin sincronización.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key
